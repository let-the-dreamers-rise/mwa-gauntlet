+            final ECParameterSpec params = algParams.getParameterSpec(ECParameterSpec.class);
+            if (!isOnCurve(w, params)) {
+                throw new IllegalArgumentException("input is not a point on EC P-256");
+            }
+            final ECPublicKeySpec ecPublicKeySpec = new ECPublicKeySpec(w, params);
             return (ECPublicKey) KeyFactory.getInstance("EC").generatePublic(ecPublicKeySpec);
